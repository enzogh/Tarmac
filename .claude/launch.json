{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "web",
      "runtimeExecutable": "npm",
      "runtimeArgs": ["--workspace", "@tarmac/web", "run", "dev"],
      "port": 3000,
      "autoPort": true
