POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tarmac
POSTGRES_BIND=127.0.0.1

# IP privée vRack de cet hôte (KS-5-B) - api et web n'écoutent que dessus,
# jamais sur l'IP publique.
VRACK_IP=10.255.0.176

# Redis n'écoute que sur 127.0.0.1 (jamais sur le vRack ni en public), sur un
# port non-standard - seul l'hôte lui-même peut y accéder (ex: debug via redis-cli).
# La communication api<->redis passe par le réseau Docker interne (hostname
# "redis", port 6379), donc changer ce port n'affecte pas l'application.
REDIS_PORT=6380

NEXT_PUBLIC_API_URL=https://tarmac.casterot.com

# Secrets applicatifs - obligatoires, générer avec `openssl rand -base64 32`
JWT_SECRET=
AGENT_SHARED_TOKEN=

# Rotation JWT_SECRET : mettre ici l'ancienne valeur de JWT_SECRET le temps
# que les sessions déjà émises (12h max) expirent, puis vider cette variable.
JWT_SECRET_PREVIOUS=
