POSTGRES_USER=postgres
POSTGRES_PASSWORD=postgres
POSTGRES_DB=tarmac
POSTGRES_BIND=127.0.0.1

# IP privée vRack de cet hôte (KS-5-B) - api et web n'écoutent que dessus,
# jamais sur l'IP publique.
VRACK_IP=10.255.0.176

# Redis n'écoute que sur 127.0.0.1 (jamais sur le vRack ni en public), sur un
# port non-standard - seul l'hôte lui-même peut y accéder (ex: debug via redis-cli).
# La communication api<->redis passe par le réseau Docker interne (hostname
# "redis", port 6379), donc changer ce port n'affecte pas l'application.
REDIS_PORT=6380

NEXT_PUBLIC_API_URL=https://tarmac.casterot.com

# Secrets applicatifs - obligatoires, générer avec `openssl rand -base64 32`
JWT_SECRET=
AGENT_SHARED_TOKEN=

# Rotation JWT_SECRET : mettre ici l'ancienne valeur de JWT_SECRET le temps
# que les sessions déjà émises (12h max) expirent, puis vider cette variable.
JWT_SECRET_PREVIOUS=

# SSO Authentik - application OAuth2/OIDC "Tarmac" créée dans l'admin
# auth.casterot.com. Les comptes Authentik superuser (claim custom
# "is_superuser", scope "tarmac") deviennent platform admin Tarmac. Les
# autres comptes n'obtiennent l'accès que si leurs groupes Authentik (claim
# "groups", exposé par le même scope mapping "tarmac" - pas de scope séparé
# à ajouter ici) correspondent au Workspace.ssoGroupClaim d'au moins un
# workspace (voir PATCH /api/v1/workspaces/:id) - sinon la connexion est
# refusée.
# Redirect URI à enregistrer côté Authentik : ${NEXT_PUBLIC_API_URL}/api/v1/auth/sso/callback
FRONTEND_URL=https://tarmac.casterot.com
AUTHENTIK_ISSUER_URL=https://auth.casterot.com/application/o/tarmac/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=https://tarmac.casterot.com/api/v1/auth/sso/callback
AUTHENTIK_SCOPES=openid profile email tarmac

# Emails d'alerte via le relais SMTP interne. SMTP_HOST vide = aucun email
# envoyé (le reste de l'API fonctionne normalement). Chaque membre d'un
# workspace reçoit les alertes sur son adresse @intraced.fr si Authentik en
# expose une (n'importe quel claim : email, attribut, claim custom du scope
# "tarmac"...), sinon sur l'adresse de son compte. Les alertes simultanées
# partent dans un seul email : envoi quand plus rien n'arrive depuis
# ALERT_EMAIL_QUIET_SECONDS, au plus tard ALERT_EMAIL_MAX_WAIT_SECONDS après
# la première.
SMTP_HOST=
SMTP_PORT=25
# true = TLS implicite (port 465) ; vide = automatique selon le port (STARTTLS sinon)
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tarmac <tarmac@intraced.fr>"
# false si le relais présente un certificat d'une CA interne
SMTP_TLS_REJECT_UNAUTHORIZED=true
ALERT_EMAIL_INTERNAL_DOMAIN=intraced.fr
ALERT_EMAIL_QUIET_SECONDS=45
ALERT_EMAIL_MAX_WAIT_SECONDS=300
ALERT_EMAIL_TIMEZONE=Europe/Paris
