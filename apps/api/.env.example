DATABASE_URL="postgresql://user:password@localhost:5432/tarmac"
JWT_SECRET=dev-secret-key-change-in-production
AGENT_SHARED_TOKEN=dev-agent-secret
# Optional (docker-compose already sets sane defaults for these)
ADMIN_EMAIL=admin@tarmac.local
ADMIN_PASSWORD=
ENABLE_DEFAULT_ADMIN=false
PORT=3001

# SSO Authentik (application "Tarmac") - login exclusivement réservé aux
# comptes Authentik superuser (claim custom "is_superuser"). Laisser vide
# pour désactiver le SSO (le login par mot de passe reste utilisable via
# l'API en secours, ex: compte admin par défaut ci-dessus).
FRONTEND_URL=http://localhost:3000
AUTHENTIK_ISSUER_URL=https://auth.casterot.com/application/o/tarmac/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:3001/api/v1/auth/sso/callback
AUTHENTIK_SCOPES=openid profile email tarmac

# Emails d'alerte via le relais SMTP interne. SMTP_HOST vide = aucun email
# envoyé (le reste de l'API fonctionne normalement). Chaque membre d'un
# workspace reçoit les alertes sur son adresse @intraced.fr si Authentik en
# expose une (n'importe quel claim : email, attribut, claim custom du scope
# "tarmac"...), sinon sur l'adresse de son compte. Les alertes simultanées
# partent dans un seul email : envoi quand plus rien n'arrive depuis
# ALERT_EMAIL_QUIET_SECONDS, au plus tard ALERT_EMAIL_MAX_WAIT_SECONDS après
# la première.
SMTP_HOST=
SMTP_PORT=25
# true = TLS implicite (port 465) ; vide = automatique selon le port (STARTTLS sinon)
SMTP_SECURE=
SMTP_USER=
SMTP_PASSWORD=
SMTP_FROM="Tarmac <tarmac@intraced.fr>"
# false si le relais présente un certificat d'une CA interne
SMTP_TLS_REJECT_UNAUTHORIZED=true
ALERT_EMAIL_INTERNAL_DOMAIN=intraced.fr
ALERT_EMAIL_QUIET_SECONDS=45
ALERT_EMAIL_MAX_WAIT_SECONDS=300
ALERT_EMAIL_TIMEZONE=Europe/Paris
