DATABASE_URL="postgresql://user:password@localhost:5432/tarmac"
JWT_SECRET=dev-secret-key-change-in-production
AGENT_SHARED_TOKEN=dev-agent-secret
# Optional (docker-compose already sets sane defaults for these)
ADMIN_EMAIL=admin@tarmac.local
ADMIN_PASSWORD=admin123
ENABLE_DEFAULT_ADMIN=true
PORT=3001

# SSO Authentik (application "Tarmac") - login exclusivement réservé aux
# comptes Authentik superuser (claim custom "is_superuser"). Laisser vide
# pour désactiver le SSO (le login par mot de passe reste utilisable via
# l'API en secours, ex: compte admin par défaut ci-dessus).
FRONTEND_URL=http://localhost:3000
AUTHENTIK_ISSUER_URL=https://auth.casterot.com/application/o/tarmac/
AUTHENTIK_CLIENT_ID=
AUTHENTIK_CLIENT_SECRET=
AUTHENTIK_REDIRECT_URI=http://localhost:3001/api/v1/auth/sso/callback
AUTHENTIK_SCOPES=openid profile email tarmac
