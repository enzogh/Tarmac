generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NodeStatus {
  offline
  online
  degraded
}

enum ShareStatus {
  pending
  active
  error
}

enum MountStatus {
  pending
  active
  error
}

enum ShareClientAccess {
  ro
  rw
  deny
}

enum DiskHealth {
  healthy
  warning
  critical
  unknown
}

enum DiskType {
  hdd
  ssd
  nvme
}

enum PoolStatus {
  pending
  active
  error
}

enum PoolMemberStatus {
  pending
  active
  error
}

enum PoolMemberRole {
  primary
  replica
}

enum DnsServerGroupStatus {
  pending
  active
  error
}

enum DnsServerGroupMemberStatus {
  pending
  active
  error
}

enum DnsServerGroupMemberRole {
  primary
  secondary
}

enum DnsZoneStatus {
  pending
  active
  error
}

enum DnsRecordStatus {
  pending
  active
  error
}

enum DnsRecordType {
  A
  AAAA
  CNAME
  MX
  TXT
  NS
  CAA
  SRV
  PTR
}

enum AlertSeverity {
  low
  medium
  high
  critical
}

enum AlertStatus {
  open
  acknowledged
  resolved
}

enum Comparator {
  gt
  gte
  lt
  lte
}

enum NotificationChannelType {
  email
  webhook
  slack
}

enum SyncJobStatus {
  pending
  running
  success
  failed
}

enum VlanConnectionStatus {
  healthy
  degraded
  offline
  unknown
}

enum MigrationStatus {
  pending
  running
  completed
  failed
}

// full: every client packet (0.0.0.0/0) goes through the tunnel and leaves
// the internet through the profile's exit node. private: only the
// workspace's private mesh is routed through the tunnel, the client keeps
// its own internet access.
enum VpnProfileMode {
  full
  private
}

// Reach of a VPN client towards one class of destinations (fleet nodes, or
// other VPN clients): everything, an explicit list, or nothing.
enum VpnAccessScope {
  all
  selected
  none
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  passwordHash         String?
  name                 String?
  avatarUrl            String?
  isSuperuser          Boolean               @default(false)
  // Mirrors membership of the Authentik access group (AUTHENTIK_ACCESS_GROUP)
  // at the last SSO login: required to sign in at all (platform admins
  // aside), and lets the user create up to WORKSPACE_CREATION_LIMIT
  // workspaces. Refreshed both ways on every login.
  canCreateWorkspaces  Boolean               @default(false)
  // Per-user override of WORKSPACE_CREATION_LIMIT, set by a platform admin
  // from /admin. Null follows the default.
  workspaceLimit       Int?
  ssoSubject           String?               @unique
  // Address on the internal mail domain (ALERT_EMAIL_INTERNAL_DOMAIN,
  // intraced.fr by default) found in the Authentik claims at the last SSO
  // login. Alert emails go here when set, otherwise to `email` - see
  // alertEmailAddress() in mail/alert-recipients.ts.
  internalEmail        String?
  alertEmailsEnabled   Boolean               @default(true)
  // Set by a platform admin from /admin: the account can no longer sign in
  // and its sessions stop working, whatever Authentik says.
  disabledAt           DateTime?
  // Sessions issued before this instant are refused (JwtStrategy). Bumped
  // when the account is disabled or AuthentikAccessSync sees it leave the
  // access group, so losing access takes effect within minutes, not at the
  // end of the 12 h session.
  sessionsRevokedAt    DateTime?
  // Last time AuthentikAccessSync confirmed the access group membership.
  accessCheckedAt      DateTime?
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  workspaceMemberships WorkspaceMembership[]
}

// A workspace groups a set of nodes (and everything hanging off them) under
// one isolated tenant. Every pre-existing row is backfilled into a single
// "Default" workspace (isDefault=true) by the add_workspace migration so
// nothing changes for the already-deployed fleet - see that migration's
// data-backfill step before touching this model.
model Workspace {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  // Slugs this workspace had before a rename: old /<slug>/dashboard links
  // and alert e-mails keep resolving (the web app redirects to `slug`). No
  // other workspace may take one of them, see WorkspacesService.update.
  previousSlugs String[] @default([])
  // Authentik group name that auto-grants membership on SSO login (Phase 3).
  // Null means membership is only ever granted manually by a platform admin.
  ssoGroupClaim String?  @unique
  isDefault     Boolean  @default(false)
  // Index into the per-workspace subnet pool (10.(16+n-1).0.0/16). Null for
  // the Default workspace, which permanently keeps the legacy 10.255.0.0/16
  // range instead so existing node IPs never move.
  subnetIndex   Int?     @unique
  // User who created it, counted against WORKSPACE_CREATION_LIMIT. Null for
  // workspaces that predate the limit.
  createdById   String?
  // Monday-morning summary emailed to the owner (createdById, or the
  // administrators of workspaces that predate it) - see WeeklyReportService.
  weeklyReportEnabled Boolean   @default(true)
  weeklyReportSentAt  DateTime?
  // Firewall between the workspace's servers (private network): "open"
  // (only explicit blocks apply), "observe" (would-be blocked traffic is
  // logged, nothing more) or "enforce" (only what a rule allows gets in).
  // See FirewallService.
  firewallMeshMode    String    @default("open")
  // Internet-facing firewall defaults shared by every node: answer ping,
  // and keep the SSH ports sshd listens on open whatever the rules say (so
  // nobody locks themselves out).
  firewallPublicPing  Boolean   @default(true)
  firewallSshGuard    Boolean   @default(true)
  // Throttle new SSH connections from the internet, per source address.
  firewallSshLimit    Boolean   @default(true)
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  // The single node (if any) running the dedicated internal PowerDNS
  // instance that serves *.tarmac.local for the whole fleet - separate
  // relation from `nodes` below (a node's normal Workspace membership),
  // since this one specific node is optionally singled out for that role.
  internalDnsNodeId String?
  internalDnsNode    Node?   @relation("InternalDnsNode", fields: [internalDnsNodeId], references: [id], onDelete: SetNull)
  // Reports back whether command.setup_internal_dns actually succeeded on
  // internalDnsNode, not just whether it was requested - reuses the same
  // pending/active/error enum already used for DnsServerGroupMember.status,
  // set from agents.service.ts's onCommandResult the same way.
  internalDnsStatus DnsServerGroupMemberStatus @default(pending)
  // The agent's message when internalDnsStatus is error, shown as-is on the
  // Nodes page; null otherwise.
  internalDnsError  String?

  memberships          WorkspaceMembership[]
  nodes                Node[]
  vlans                Vlan[]
  shares               Share[]
  mounts               Mount[]
  alertRules           AlertRule[]
  alerts               Alert[]
  syncJobs             SyncJob[]
  migrationTasks       MigrationTask[]
  pools                Pool[]
  dnsServerGroups      DnsServerGroup[]
  dnsZones             DnsZone[]
  notificationChannels NotificationChannel[]
  auditLogs            AuditLog[]
  vpnProfiles          VpnProfile[]
  apiKeys              ApiKey[]
  customRoles          WorkspaceCustomRole[]
  invitations          WorkspaceInvitation[]
  firewallRules        FirewallRule[]

  @@index([createdById])
}

// A named set of member permissions defined by a workspace's administrators
// ("Opérateur stockage", "Support N1"...). Members holding it follow its
// permissions: editing the role updates every one of them.
model WorkspaceCustomRole {
  id          String                @id @default(cuid())
  workspaceId String
  workspace   Workspace             @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name        String
  description String?
  permissions String[]              @default([])
  createdAt   DateTime              @default(now())
  updatedAt   DateTime              @updatedAt
  memberships WorkspaceMembership[]
  invitations WorkspaceInvitation[]

  @@unique([workspaceId, name])
}

// Someone invited by email before they ever signed in to Tarmac. Turned into
// a membership at their first SSO login with that address (AuthService).
model WorkspaceInvitation {
  id           String               @id @default(cuid())
  workspaceId  String
  workspace    Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  email        String
  role         String               @default("member")
  permissions  String[]             @default([])
  customRoleId String?
  customRole   WorkspaceCustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  invitedById  String?
  lastSentAt   DateTime?
  expiresAt    DateTime
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt

  @@unique([workspaceId, email])
  @@index([email])
}

// Platform-wide settings edited from /admin (key -> JSON value). Each key
// falls back to its environment variable when absent.
model PlatformSetting {
  key         String   @id
  value       Json
  updatedById String?
  updatedAt   DateTime @updatedAt
}

// One row per node and day (Europe/Paris), filled every minute: how long the
// node was watched and seen online, and its disk usage at the last sample.
// Feeds availability and storage growth in the weekly report, since raw
// metrics are only kept three days.
model NodeDailyStat {
  nodeId          String
  day             DateTime @db.Date
  observedMinutes Int      @default(0)
  onlineMinutes   Int      @default(0)
  diskUsedGb      Int?
  diskCapacityGb  Int?
  node            Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@id([nodeId, day])
  @@index([day])
}

model WorkspaceMembership {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  // "owner" administers the workspace (settings, members, API keys) and
  // reaches everything; "member" reaches what `permissions` grants.
  role        String    @default("member")
  // Same vocabulary as ApiKey.scopes ("<resource>:read|write", write
  // implying read), enforced by WorkspaceGuard for members. Defaults to
  // everything, which is what a membership meant before roles existed.
  permissions String[]  @default(["nodes:read", "nodes:write", "storage:read", "storage:write", "network:read", "network:write", "firewall:read", "firewall:write", "dns:read", "dns:write", "vpn:read", "vpn:write", "alerts:read", "alerts:write", "logs:read"])
  // "manual" (platform-admin-granted, incl. the Phase 0 backfill) vs "sso"
  // (granted by an Authentik group claim). Lets a future full add+revoke SSO
  // sync only ever touch rows it itself created.
  source      String    @default("manual")
  // Custom role the member follows (permissions are copied from it and kept
  // in step); null for the built-in roles. Deleting the role leaves the
  // member with its permissions, shown as "Personnalisé".
  customRoleId String?
  customRole   WorkspaceCustomRole? @relation(fields: [customRoleId], references: [id], onDelete: SetNull)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Node {
  id                     String                 @id @default(cuid())
  workspaceId            String
  workspace              Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name                   String
  role                   String
  status                 NodeStatus             @default(offline)
  locationCity           String?
  locationCountry        String?
  locationCountryCode    String?
  locationLat            Float?
  locationLng            Float?
  graphX                 Float?
  graphY                 Float?
  lastSeenAt             DateTime?
  vlanIp                 String?                @unique
  vlanMac                String?                @unique
  overlayPublicKey       String?
  overlayEndpoint        String?
  overlayListenPort      Int?
  overlaySshPublicKey    String?
  overlaySshUser         String?
  overlayIsGateway       Boolean                @default(false)
  // Takes over the region's gateway role while the primary is offline (see
  // AgentsService.checkGatewayFailover).
  overlayIsBackupGateway Boolean                @default(false)
  agentVersion           String?
  agentVersionAt         DateTime?
  agentTokenHash         String?
  agentTokenPreviousHash String?
  agentTokenGraceUntil   DateTime?
  agentTokenRotatedAt    DateTime?
  mutedUntil             DateTime?
  // Opt out of SMART for this node. A VPS usually sits on virtualised
  // storage whose SMART attributes are either absent or the hypervisor's,
  // so a permanent "disque en échec" on a machine with no physical disk is
  // noise that trains people to ignore the real ones. Disabling stops the
  // alerts and the red state; the reports keep being stored, so turning it
  // back on doesn't lose the history.
  smartMonitoringEnabled Boolean                @default(true)
  // Free-form labels to sort a large fleet (site, client, usage), shared by
  // everyone in the workspace.
  labels                 String[]               @default([])
  // Hardware and OS as last reported by the agent (CPU model/cores, total
  // RAM and swap, load average, OS, kernel, uptime) - refreshed with every
  // heartbeat, see systemInfo in the agent's system.go.
  systemInfo             Json?
  // On DNS server nodes: PowerDNS version, backend and the state of the
  // agent's maintenance tasks (lmdb migration, version upgrade), from the
  // heartbeat - see the agent's dnsServerReport.
  dnsServerState         Json?
  // Public half of the key the node clones and updates its agent with
  // ("<type> <base64>"), as its agent reports it - and the id of that key
  // among the repository's deploy keys on GitHub, once linked. See
  // GithubDeployKeysService.
  deployKeyPublic        String?
  githubDeployKeyId      String?
  // Custom label for <dnsHostname>.tarmac.local when this workspace has a
  // node designated to run the internal DNS zone (see Workspace.
  // internalDnsNode) - null means derive one from `name` instead.
  dnsHostname            String?
  // Status of THIS node's own local fallback resolver for *.tarmac.local
  // (a dnsmasq forwarder on port 53, only installed when systemd-resolved's
  // per-link routing isn't usable here) - null means never attempted / not
  // applicable (e.g. this node already runs its own PowerDNS on port 53 for
  // a DnsServerGroup, deliberately never touched). "active" | "conflict" | "error".
  internalDnsForwarderStatus   String?
  // { port, protocol, pid, processName } when status is "conflict" - same
  // shape as DnsServerGroupMember.conflictDetail, surfaced the same way.
  internalDnsForwarderConflict Json?
  // Index of the /24 handed to WireGuard clients connecting through this
  // node (10.x.(100+n).0/24 inside the workspace mesh range) - allocated the
  // first time a VPN profile uses this node as its entry point, then kept
  // so clients' addresses never move. See VpnService.ensureEntrySubnet.
  vpnSubnetIndex         Int?
  // Revision (ISO timestamp sent by the API) of the last command.apply_vpn
  // this node acknowledged, and whether that apply succeeded - a profile is
  // only reported as deployed once both its entry and exit nodes have
  // applied a revision at least as recent as its own configChangedAt.
  vpnAppliedRevision     DateTime?
  vpnApplyStatus         String?
  vpnApplyError          String?
  // Progress of the last agent update asked from the dashboard:
  // sent -> restarting -> done, or failed / timeout with a readable message
  // (see AgentsService.triggerAgentUpdate and the heartbeat that closes it).
  agentUpdateStatus            String?
  agentUpdateMessage           String?
  agentUpdateFromVersion       String?
  agentUpdateToVersion         String?
  agentUpdateStartedAt         DateTime?
  agentUpdateFinishedAt        DateTime?
  // Internet-facing firewall of this node: "open" (only explicit blocks),
  // "observe" or "enforce" - per node, since every server exposes
  // different things and filtering is best rolled out one at a time.
  firewallPublicMode           String    @default("open")
  // Same contract as vpnAppliedRevision/vpnApplyStatus, for
  // command.apply_firewall ("active" | "error" | "outdated").
  firewallAppliedRevision      DateTime?
  firewallApplyStatus          String?
  firewallApplyError           String?
  // Last firewall report from the agent: listening ports, internet
  // interfaces, Docker, whether blocked connections can be logged.
  firewallReport               Json?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  metrics                MetricSample[]
  shares                 Share[]
  mounts                 Mount[]
  disks                  Disk[]
  smartReports           SmartReport[]
  poolMembers            PoolMember[]
  dnsServerGroupMembers  DnsServerGroupMember[]
  dnsRecordValues        DnsRecordValue[]
  alertRules             AlertRule[]            @relation("NodeAlertRules")
  alerts                 Alert[]                @relation("NodeAlerts")
  sourceMigrations       MigrationTask[]        @relation("MigrationSourceNode")
  targetMigrations       MigrationTask[]        @relation("MigrationTargetNode")
  syncJobs               SyncJob[]
  vlanMemberships        VlanMember[]
  outgoingConnections    VlanConnection[]       @relation("SourceNode")
  incomingConnections    VlanConnection[]       @relation("TargetNode")
  internalDnsForWorkspace Workspace[]           @relation("InternalDnsNode")
  vpnEntryProfiles       VpnProfile[]           @relation("VpnEntryNode")
  vpnExitProfiles        VpnProfile[]           @relation("VpnExitNode")
  dailyStats                   NodeDailyStat[]
  firewallEvents               FirewallEvent[]

  @@unique([workspaceId, vpnSubnetIndex])
  @@index([workspaceId])
}

model Share {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  path        String
  status      ShareStatus   @default(pending)
  nodeId      String?
  node        Node?         @relation(fields: [nodeId], references: [id])
  clients     ShareClient[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([workspaceId])
}

model ShareClient {
  id        String            @id @default(cuid())
  shareId   String
  clientId  String
  access    ShareClientAccess @default(ro)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  share     Share             @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@unique([shareId, clientId])
}

model Mount {
  id                String      @id @default(cuid())
  workspaceId       String
  workspace         Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name              String
  sourcePath        String
  additionalSources String[]    @default([])
  targetPath        String
  fsType            String      @default("nfs")
  mountOptions      String?
  // Optional remote SSH source for fsType "rclone-sftp" (e.g. an external
  // seedbox with no root access, not a Tarmac node). Auth is by SSH key only
  // - the executing node's own agent key (Node.overlaySshPublicKey) must be
  // added to the remote host's authorized_keys. No password is ever stored.
  remoteHost        String?
  remoteUser        String?
  remoteSshPort     Int?        @default(22)
  status            MountStatus @default(pending)
  lastError         String?
  nodeId            String?
  node              Node?       @relation(fields: [nodeId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
  @@index([workspaceId])
}

model MetricSample {
  id        String   @id @default(cuid())
  nodeId    String
  cpu       Float
  ram       Float
  disk      Float
  networkRx Float    @default(0)
  networkTx Float    @default(0)
  ioRead    Float    @default(0)
  ioWrite   Float    @default(0)
  createdAt DateTime @default(now())
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, createdAt])
  // Supports NodesService.pruneOldMetricSamples' retention cron, which
  // filters on createdAt alone - the composite index above doesn't help a
  // query that doesn't also filter on nodeId (same pattern as AgentLog,
  // which has both for exactly this reason).
  @@index([createdAt])
}

model Disk {
  id            String     @id @default(cuid())
  nodeId        String
  name          String
  mountPath     String
  type          DiskType   @default(hdd)
  health        DiskHealth @default(unknown)
  capacityGb    Int
  usedGb        Int
  physicalDisks String[]   @default([])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  node          Node       @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, name])
  @@index([nodeId])
}

model SmartReport {
  id                 String     @id @default(cuid())
  nodeId             String
  diskName           String
  temperatureC       Int
  reallocatedSectors Int
  pendingSectors     Int
  powerOnHours       Int
  overall            DiskHealth @default(unknown)
  collectedAt        DateTime   @default(now())
  node               Node       @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, collectedAt])
  @@index([nodeId, diskName, collectedAt])
  // Supports NodesService.pruneOldSmartReports' retention cron, which
  // filters on collectedAt alone - the composite indexes above don't help a
  // query that doesn't also filter on nodeId (same pattern as MetricSample
  // and AgentLog, which both carry this index for exactly this reason).
  @@index([collectedAt])
}

model Pool {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  strategy    String
  status      PoolStatus   @default(pending)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     PoolMember[]

  // Names are per workspace: two clients may each have a "media" pool.
  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model PoolMember {
  id        String           @id @default(cuid())
  poolId    String
  nodeId    String
  role      PoolMemberRole   @default(replica)
  status    PoolMemberStatus @default(pending)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  pool      Pool             @relation(fields: [poolId], references: [id], onDelete: Cascade)
  node      Node             @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([poolId, nodeId])
  @@index([nodeId])
  @@index([status])
}

// A DNS server group is a fleet of nodes running PowerDNS for one or more
// zones, with one `primary` (master) and one or more `secondary` (slave)
// members - real AXFR/IXFR zone transfer between them, not a Tarmac-managed
// config push, so a secondary keeps answering correctly even if the control
// plane or the primary node is down. Structurally mirrors Pool/PoolMember.
model DnsServerGroup {
  id            String                 @id @default(cuid())
  workspaceId   String
  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name          String
  status        DnsServerGroupStatus   @default(pending)
  // Shared secret for AXFR/IXFR zone transfer between this group's members,
  // generated by whichever node is `primary` and relayed to `secondary`
  // members via the reconciliation loop. Encrypted at rest with
  // TARMAC_SECRETS_KEY (common/secret-box.ts) - unlike Node.agentTokenHash,
  // this can't be a one-way hash since secondaries need the literal value
  // to configure PowerDNS.
  tsigKeySecret String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  members       DnsServerGroupMember[]
  zones         DnsZone[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model DnsServerGroupMember {
  id             String                     @id @default(cuid())
  groupId        String
  nodeId         String
  role           DnsServerGroupMemberRole   @default(secondary)
  status         DnsServerGroupMemberStatus @default(pending)
  // Set by the agent when it can't bind port 53 while applying this member's
  // PowerDNS install ({ port, protocol, pid, processName }). Cleared as soon
  // as a subsequent apply/resolve succeeds. Surfaced in the DNS UI so the
  // user can choose to kill the conflicting process or pick another node.
  conflictDetail Json?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  group          DnsServerGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  node           Node                       @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([groupId, nodeId])
  @@index([nodeId])
  @@index([status])
}

model DnsZone {
  id            String         @id @default(cuid())
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  groupId       String
  group         DnsServerGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  // FQDN without a trailing dot; the PowerDNS-style trailing-dot convention
  // is applied only at the service/agent boundary, not stored here.
  name          String
  dnssecEnabled Boolean        @default(true)
  status        DnsZoneStatus  @default(pending)
  // Real-world delegation verification (see DnsDelegationCheckService) -
  // distinct from `status` above, which only reflects local PowerDNS-apply
  // success and says nothing about whether the registrar/parent zone
  // actually points at us yet on the public internet.
  delegationVerified  Boolean   @default(false)
  delegationCheckedAt DateTime?
  // Per-nameserver breakdown: [{ host, expectedIp, nsVisible, resolvedIp, matches, ok }]
  delegationDetail    Json?
  // Zone transfer health (see DnsSyncCheckService): each member's SOA
  // serial compared with the primary's.
  // [{ nodeId, role, serial, ok, behindSince, error }]
  syncCheckedAt       DateTime?
  syncDetail          Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  records       DnsRecord[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([groupId])
  @@index([status, delegationVerified])
}

// One row = one RRset (all values for a given name+type answered together).
model DnsRecord {
  id        String           @id @default(cuid())
  zoneId    String
  zone      DnsZone          @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  // Relative label ("www", "@" for the zone apex).
  name      String
  type      DnsRecordType
  ttl       Int              @default(3600)
  // false: plain multi-value RRset (round-robin). true: rendered as a
  // PowerDNS Lua record (pickclosest(...)) over `values` for GeoDNS.
  isGeo     Boolean          @default(false)
  status    DnsRecordStatus  @default(pending)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  values    DnsRecordValue[]

  @@unique([zoneId, name, type])
  @@index([zoneId])
  @@index([status])
}

model DnsRecordValue {
  id        String    @id @default(cuid())
  recordId  String
  record    DnsRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  // IP for A/AAAA, hostname for CNAME/MX/NS, free text for TXT/CAA.
  content   String
  // Set when this value targets one of the workspace's own fleet nodes -
  // drives the "which records point here" reverse lookup from a node.
  nodeId    String?
  node      Node?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  // MX/SRV only.
  priority  Int?
  createdAt DateTime  @default(now())

  @@index([recordId])
  @@index([nodeId])
}

model NotificationChannel {
  id          String                  @id @default(cuid())
  workspaceId String
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  type        NotificationChannelType
  target      String
  enabled     Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  rules       AlertRule[]

  @@index([workspaceId])
}

model AlertRule {
  id                    String               @id @default(cuid())
  workspaceId           String
  workspace             Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name                  String
  metric                String
  comparator            Comparator           @default(gte)
  threshold             Float
  severity              AlertSeverity        @default(medium)
  enabled               Boolean              @default(true)
  nodeId                String?
  notificationChannelId String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  node                  Node?                @relation("NodeAlertRules", fields: [nodeId], references: [id])
  notificationChannel   NotificationChannel? @relation(fields: [notificationChannelId], references: [id])
  alerts                Alert[]

  @@index([enabled])
  @@index([workspaceId])
}

model Alert {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  ruleId         String?
  nodeId         String?
  message        String
  severity       AlertSeverity @default(medium)
  status         AlertStatus   @default(open)
  triggeredAt    DateTime      @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  // Set once the alert has gone out in an email digest (or was deliberately
  // skipped) - null means AlertDigestService still has to pick it up.
  emailNotifiedAt DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  rule           AlertRule?    @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  node           Node?         @relation("NodeAlerts", fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([triggeredAt])
  @@index([status])
  @@index([nodeId])
  // Lists are per workspace, newest first.
  @@index([workspaceId, triggeredAt])
  @@index([emailNotifiedAt])
}

model SyncJob {
  id                    String        @id @default(cuid())
  workspaceId           String
  workspace             Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name                  String
  sourcePath            String
  targetPath            String
  schedule              String
  status                SyncJobStatus @default(pending)
  nodeId                String?
  // Optional remote SSH source (e.g. an external seedbox outside the Tarmac
  // node fleet). When set, the agent pulls sourcePath from this host instead
  // of treating it as a local path. Auth is by SSH key only - the agent's own
  // key (public key surfaced via Node.overlaySshPublicKey) must be added to
  // the remote host's authorized_keys. No password is ever stored at rest.
  sourceHost            String?
  sourceUser            String?
  sourceSshPort         Int?          @default(22)
  // Hash of the per-job secret used by POST /sync-jobs/:id/trigger to start a
  // run without an interactive JWT session (e.g. from a qBittorrent
  // "run on completion" script). Same sha256-at-rest pattern as
  // Node.agentTokenHash - the plaintext is only ever returned once, at
  // creation or rotation time.
  triggerTokenHash      String?
  triggerTokenRotatedAt DateTime?
  lastRunAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  node                  Node?         @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  runs                  SyncJobRun[]

  @@index([workspaceId])
}

model SyncJobRun {
  id               String        @id @default(cuid())
  syncJobId        String
  status           SyncJobStatus @default(running)
  trigger          String        @default("manual")
  bytesTransferred Int           @default(0)
  log              String?
  startedAt        DateTime      @default(now())
  finishedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  syncJob          SyncJob       @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId, startedAt])
}

model MigrationTask {
  id           String          @id @default(cuid())
  workspaceId  String
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name         String
  shareId      String?
  sourceNodeId String?
  targetNodeId String?
  status       MigrationStatus @default(pending)
  progress     Int             @default(0)
  notes        String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sourceNode   Node?           @relation("MigrationSourceNode", fields: [sourceNodeId], references: [id], onDelete: SetNull)
  targetNode   Node?           @relation("MigrationTargetNode", fields: [targetNodeId], references: [id], onDelete: SetNull)

  @@index([sourceNodeId, status])
  @@index([workspaceId])
}

// resourceType/resourceId stay generic (no FK) since AuditLog spans every
// resource kind. workspaceId is nullable because some rows predate
// workspaces or record platform-level (cross-workspace) actions.
model AuditLog {
  id           String     @id @default(cuid())
  workspaceId  String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  details      Json?
  createdAt    DateTime   @default(now())

  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
  @@index([resourceType])
  // The journal is read per workspace, newest first.
  @@index([workspaceId, createdAt])
}

model AgentLog {
  id        String   @id @default(cuid())
  nodeId    String
  level     String
  message   String
  createdAt DateTime @default(now())

  @@index([nodeId, createdAt])
  @@index([createdAt])
}

model Vlan {
  id                String                 @id @default(cuid())
  // One workspace has exactly one Vlan (its private mesh) - see
  // vlan.service.ts getOrCreateVlan. Kept as a plain FK rather than 1:1
  // unique-constrained for now to avoid over-constraining before Phase 2
  // actually enforces the invariant in code.
  workspaceId       String
  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name              String                 @unique
  subnetCidr        String
  description       String?
  status            String                 @default("active")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  members           VlanMember[]
  connections       VlanConnection[]
  connectionSamples VlanConnectionSample[]
  connectionRollups VlanConnectionRollup[]

  @@index([workspaceId])
}

model VlanMember {
  id            String   @id @default(cuid())
  vlanId        String
  nodeId        String
  vlanIp        String
  vlanMac       String
  joinedAt      DateTime @default(now())
  lastHeartbeat DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  vlan          Vlan     @relation(fields: [vlanId], references: [id], onDelete: Cascade)
  node          Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([vlanId, nodeId])
  @@unique([vlanId, vlanIp])
  @@unique([vlanId, vlanMac])
  @@index([vlanId])
  @@index([nodeId])
}

model VlanConnection {
  id            String               @id @default(cuid())
  vlanId        String
  sourceNodeId  String
  targetNodeId  String
  status        VlanConnectionStatus @default(unknown)
  latencyMs     Float?
  packetLoss    Float?
  bandwidth     Float?
  lastCheckedAt DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  vlan          Vlan                 @relation(fields: [vlanId], references: [id], onDelete: Cascade)
  sourceNode    Node                 @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode    Node                 @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([vlanId, sourceNodeId, targetNodeId])
  @@index([vlanId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

model VlanConnectionSample {
  id           String               @id @default(cuid())
  vlanId       String
  sourceNodeId String
  targetNodeId String
  status       VlanConnectionStatus
  latencyMs    Float?
  packetLoss   Float?
  bandwidth    Float?
  createdAt    DateTime             @default(now())
  vlan         Vlan                 @relation(fields: [vlanId], references: [id], onDelete: Cascade)

  @@index([vlanId, sourceNodeId, targetNodeId, createdAt])
  @@index([createdAt])
}

// Hourly aggregate of VlanConnectionSample, kept long after the raw samples
// are pruned (48 h). One row per unordered pair: sourceNodeId is the smaller
// id, since samples are throttled per pair whatever their direction.
model VlanConnectionRollup {
  id           String               @id @default(cuid())
  vlanId       String
  sourceNodeId String
  targetNodeId String
  bucketStart  DateTime
  sampleCount  Int
  healthyCount Int
  worstStatus  VlanConnectionStatus
  latencyMs    Float?
  packetLoss   Float?
  bandwidth    Float?
  vlan         Vlan                 @relation(fields: [vlanId], references: [id], onDelete: Cascade)

  @@unique([vlanId, sourceNodeId, targetNodeId, bucketStart])
  @@index([bucketStart])
}

// A WireGuard client profile: one device/person connecting to the fleet.
// The client always connects to `entryNode`; in `full` mode its internet
// traffic then leaves through `exitNode` (relayed over the private mesh), or
// through the entry node itself when exitNodeId is null. Switching the exit
// is a routing change on the nodes only - the client's own config (keys,
// endpoint, address) never changes, so it stays connected while its public
// IP moves.
model VpnProfile {
  id                String         @id @default(cuid())
  workspaceId       String
  workspace         Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name              String
  description       String?
  mode              VpnProfileMode @default(full)
  entryNodeId       String
  entryNode         Node           @relation("VpnEntryNode", fields: [entryNodeId], references: [id], onDelete: Cascade)
  exitNodeId        String?
  exitNode          Node?          @relation("VpnExitNode", fields: [exitNodeId], references: [id], onDelete: SetNull)
  // Address inside the entry node's client /24.
  clientIp          String
  clientPublicKey   String         @unique
  // Null when the caller brought its own key pair (only the public half was
  // sent): the downloadable config then carries a placeholder instead.
  // Encrypted at rest like DnsServerGroup.tsigKeySecret (and presharedKey
  // below) - it has to be handed back verbatim to re-download the config.
  clientPrivateKey  String?
  presharedKey      String
  dns               String[]       @default([])
  // Free-form labels to sort a large fleet of profiles (team, site, usage).
  tags              String[]       @default([])
  // What this client may open connections to, enforced by its entry node's
  // firewall (replies to allowed connections always come back). `meshAccess`
  // covers the fleet's private IPs - the entry node itself included -,
  // `peerAccess` the other VPN clients, on any entry node. Internet access
  // follows `mode`. Ids of deleted nodes/profiles are dropped on the fly.
  meshAccess        VpnAccessScope @default(all)
  meshNodeIds       String[]       @default([])
  peerAccess        VpnAccessScope @default(none)
  peerProfileIds    String[]       @default([])
  enabled           Boolean        @default(true)
  expiresAt         DateTime?
  // Bumped on every change that alters what the nodes must apply (entry,
  // exit, mode, keys, enabled) - see Node.vpnAppliedRevision.
  configChangedAt   DateTime       @default(now())
  exitSwitchedAt    DateTime?
  // Live session state, reported by the entry node's agent (wg show dump).
  lastHandshakeAt   DateTime?
  clientEndpoint    String?
  rxBytes           Float          @default(0)
  txBytes           Float          @default(0)
  createdByUserId   String?
  createdByApiKeyId String?
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt

  @@unique([entryNodeId, clientIp])
  @@index([workspaceId])
  @@index([exitNodeId])
}

// Sessions ended by a logout before their 12 h expiry. A signed session
// token stays valid until it expires, so logging out records its id (jti)
// here and SessionValidityService refuses it. Rows past expiresAt are useless
// and swept hourly.
model RevokedSession {
  jti       String   @id
  userId    String
  expiresAt DateTime
  createdAt DateTime @default(now())

  @@index([expiresAt])
}

// Workspace-scoped API key for programmatic access (e.g. provisioning VPN
// profiles from another system). Format: tmk_<prefix>_<secret>; only
// sha256(secret) is stored, the full token is shown once at creation - same
// pattern as Node.agentTokenHash / SyncJob.triggerTokenHash.
model ApiKey {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  name            String
  prefix          String    @unique
  secretHash      String
  scopes          String[]  @default([])
  createdByUserId String?
  lastUsedAt      DateTime?
  lastUsedIp      String?
  expiresAt       DateTime?
  revokedAt       DateTime?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId])
}

// One firewall rule of a workspace. `scope` says where it applies: "mesh"
// (traffic between the workspace's servers over the private network) or
// "public" (traffic from the internet). Sources are nodes/labels on the mesh
// and CIDRs on the internet; targets are always this workspace's nodes. An
// empty `ports` list means every port. Blocks ("deny") always win over
// allows. Ids of deleted nodes are dropped on the fly.
model FirewallRule {
  id              String    @id @default(cuid())
  workspaceId     String
  workspace       Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  scope           String
  action          String    @default("allow")
  name            String
  description     String?
  enabled         Boolean   @default(true)
  // any | nodes | labels (mesh) - any | cidrs (public)
  sourceKind      String    @default("any")
  sourceNodeIds   String[]  @default([])
  sourceLabels    String[]  @default([])
  sourceCidrs     String[]  @default([])
  // any | nodes | labels
  targetKind      String    @default("any")
  targetNodeIds   String[]  @default([])
  targetLabels    String[]  @default([])
  // any | tcp | udp | tcpudp | icmp
  protocol        String    @default("tcp")
  ports           String[]  @default([])
  // Temporary rules (e.g. "SSH from my IP for 2 h") switch themselves off.
  expiresAt       DateTime?
  // Packets matched, summed over the nodes' counters - see
  // FirewallService.ingestReport.
  hitCount        Float     @default(0)
  lastHitAt       DateTime?
  createdByUserId String?
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt

  @@index([workspaceId])
}

// Connections a node's firewall blocked (or, in observation mode, would
// have blocked), aggregated per hour so a scan doesn't turn into millions
// of rows. On the private network a row is one source; from the internet
// it is one port, with a sample of the sources seen.
model FirewallEvent {
  id           String   @id @default(cuid())
  workspaceId  String
  nodeId       String
  node         Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)
  scope        String
  verdict      String
  // Matching key, see FirewallService.eventKey.
  key          String
  sourceIp     String
  sourceNodeId String?
  sources      String[] @default([])
  protocol     String
  port         Int      @default(0)
  docker       Boolean  @default(false)
  ruleId       String?
  count        Int      @default(0)
  bucketStart  DateTime
  firstSeenAt  DateTime
  lastSeenAt   DateTime

  @@unique([nodeId, key, bucketStart])
  @@index([workspaceId, lastSeenAt])
  @@index([lastSeenAt])
}
