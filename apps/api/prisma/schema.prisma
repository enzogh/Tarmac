generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum NodeStatus {
  offline
  online
  degraded
}

enum ShareStatus {
  pending
  active
  error
}

enum MountStatus {
  pending
  active
  error
}

enum ShareClientAccess {
  ro
  rw
  deny
}

enum DiskHealth {
  healthy
  warning
  critical
  unknown
}

enum DiskType {
  hdd
  ssd
  nvme
}

enum PoolStatus {
  pending
  active
  error
}

enum PoolMemberStatus {
  pending
  active
  error
}

enum PoolMemberRole {
  primary
  replica
}

enum DnsServerGroupStatus {
  pending
  active
  error
}

enum DnsServerGroupMemberStatus {
  pending
  active
  error
}

enum DnsServerGroupMemberRole {
  primary
  secondary
}

enum DnsZoneStatus {
  pending
  active
  error
}

enum DnsRecordStatus {
  pending
  active
  error
}

enum DnsRecordType {
  A
  AAAA
  CNAME
  MX
  TXT
  NS
  CAA
  SRV
  PTR
}

enum AlertSeverity {
  low
  medium
  high
  critical
}

enum AlertStatus {
  open
  acknowledged
  resolved
}

enum Comparator {
  gt
  gte
  lt
  lte
}

enum NotificationChannelType {
  email
  webhook
  slack
}

enum SyncJobStatus {
  pending
  running
  success
  failed
}

enum VlanConnectionStatus {
  healthy
  degraded
  offline
  unknown
}

enum VlanTestType {
  ping
  traceroute
}

enum MigrationStatus {
  pending
  running
  completed
  failed
}

model User {
  id                   String                @id @default(cuid())
  email                String                @unique
  passwordHash         String?
  name                 String?
  avatarUrl            String?
  isSuperuser          Boolean               @default(false)
  ssoSubject           String?               @unique
  createdAt            DateTime              @default(now())
  updatedAt            DateTime              @updatedAt
  workspaceMemberships WorkspaceMembership[]
}

// A workspace groups a set of nodes (and everything hanging off them) under
// one isolated tenant. Every pre-existing row is backfilled into a single
// "Default" workspace (isDefault=true) by the add_workspace migration so
// nothing changes for the already-deployed fleet - see that migration's
// data-backfill step before touching this model.
model Workspace {
  id            String   @id @default(cuid())
  name          String
  slug          String   @unique
  // Authentik group name that auto-grants membership on SSO login (Phase 3).
  // Null means membership is only ever granted manually by a platform admin.
  ssoGroupClaim String?  @unique
  isDefault     Boolean  @default(false)
  // Index into the per-workspace subnet pool (10.(16+n-1).0.0/16). Null for
  // the Default workspace, which permanently keeps the legacy 10.255.0.0/16
  // range instead so existing node IPs never move.
  subnetIndex   Int?     @unique
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt

  memberships          WorkspaceMembership[]
  nodes                Node[]
  vlans                Vlan[]
  shares               Share[]
  mounts               Mount[]
  alertRules           AlertRule[]
  alerts               Alert[]
  syncJobs             SyncJob[]
  migrationTasks       MigrationTask[]
  pools                Pool[]
  dnsServerGroups      DnsServerGroup[]
  dnsZones             DnsZone[]
  notificationChannels NotificationChannel[]
  auditLogs            AuditLog[]
}

model WorkspaceMembership {
  id          String    @id @default(cuid())
  workspaceId String
  userId      String
  // Reserved for owner/admin/viewer distinctions later; v1 authz treats any
  // membership row as full access to the workspace regardless of this value.
  role        String    @default("member")
  // "manual" (platform-admin-granted, incl. the Phase 0 backfill) vs "sso"
  // (granted by an Authentik group claim). Lets a future full add+revoke SSO
  // sync only ever touch rows it itself created.
  source      String    @default("manual")
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt
  workspace   Workspace @relation(fields: [workspaceId], references: [id], onDelete: Cascade)
  user        User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([workspaceId, userId])
  @@index([userId])
}

model Node {
  id                     String                 @id @default(cuid())
  workspaceId            String
  workspace              Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name                   String
  role                   String
  status                 NodeStatus             @default(offline)
  locationCity           String?
  locationCountry        String?
  locationCountryCode    String?
  locationLat            Float?
  locationLng            Float?
  graphX                 Float?
  graphY                 Float?
  lastSeenAt             DateTime?
  vlanIp                 String?                @unique
  vlanMac                String?                @unique
  overlayPublicKey       String?
  overlayEndpoint        String?
  overlayListenPort      Int?
  overlaySshPublicKey    String?
  overlaySshUser         String?
  overlayIsGateway       Boolean                @default(false)
  agentVersion           String?
  agentVersionAt         DateTime?
  agentTokenHash         String?
  agentTokenPreviousHash String?
  agentTokenGraceUntil   DateTime?
  agentTokenRotatedAt    DateTime?
  mutedUntil             DateTime?
  createdAt              DateTime               @default(now())
  updatedAt              DateTime               @updatedAt
  metrics                MetricSample[]
  shares                 Share[]
  mounts                 Mount[]
  disks                  Disk[]
  smartReports           SmartReport[]
  poolMembers            PoolMember[]
  dnsServerGroupMembers  DnsServerGroupMember[]
  dnsRecordValues        DnsRecordValue[]
  alertRules             AlertRule[]            @relation("NodeAlertRules")
  alerts                 Alert[]                @relation("NodeAlerts")
  sourceMigrations       MigrationTask[]        @relation("MigrationSourceNode")
  targetMigrations       MigrationTask[]        @relation("MigrationTargetNode")
  syncJobs               SyncJob[]
  vlanMemberships        VlanMember[]
  outgoingConnections    VlanConnection[]       @relation("SourceNode")
  incomingConnections    VlanConnection[]       @relation("TargetNode")
  connectionTests        VlanConnectionTest[]   @relation("InitiatorNode")

  @@index([workspaceId])
}

model Share {
  id          String        @id @default(cuid())
  workspaceId String
  workspace   Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  path        String
  status      ShareStatus   @default(pending)
  nodeId      String?
  node        Node?         @relation(fields: [nodeId], references: [id])
  clients     ShareClient[]
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@index([status])
  @@index([workspaceId])
}

model ShareClient {
  id        String            @id @default(cuid())
  shareId   String
  clientId  String
  access    ShareClientAccess @default(ro)
  createdAt DateTime          @default(now())
  updatedAt DateTime          @updatedAt
  share     Share             @relation(fields: [shareId], references: [id], onDelete: Cascade)

  @@unique([shareId, clientId])
}

model Mount {
  id                String      @id @default(cuid())
  workspaceId       String
  workspace         Workspace   @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name              String
  sourcePath        String
  additionalSources String[]    @default([])
  targetPath        String
  fsType            String      @default("nfs")
  mountOptions      String?
  // Optional remote SSH source for fsType "rclone-sftp" (e.g. an external
  // seedbox with no root access, not a Tarmac node). Auth is by SSH key only
  // - the executing node's own agent key (Node.overlaySshPublicKey) must be
  // added to the remote host's authorized_keys. No password is ever stored.
  remoteHost        String?
  remoteUser        String?
  remoteSshPort     Int?        @default(22)
  status            MountStatus @default(pending)
  lastError         String?
  nodeId            String?
  node              Node?       @relation(fields: [nodeId], references: [id])
  createdAt         DateTime    @default(now())
  updatedAt         DateTime    @updatedAt

  @@index([status])
  @@index([workspaceId])
}

model MetricSample {
  id        String   @id @default(cuid())
  nodeId    String
  cpu       Float
  ram       Float
  disk      Float
  networkRx Float    @default(0)
  networkTx Float    @default(0)
  ioRead    Float    @default(0)
  ioWrite   Float    @default(0)
  createdAt DateTime @default(now())
  node      Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, createdAt])
  // Supports NodesService.pruneOldMetricSamples' retention cron, which
  // filters on createdAt alone - the composite index above doesn't help a
  // query that doesn't also filter on nodeId (same pattern as AgentLog,
  // which has both for exactly this reason).
  @@index([createdAt])
}

model Disk {
  id            String     @id @default(cuid())
  nodeId        String
  name          String
  mountPath     String
  type          DiskType   @default(hdd)
  health        DiskHealth @default(unknown)
  capacityGb    Int
  usedGb        Int
  physicalDisks String[]   @default([])
  createdAt     DateTime   @default(now())
  updatedAt     DateTime   @updatedAt
  node          Node       @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([nodeId, name])
  @@index([nodeId])
}

model SmartReport {
  id                 String     @id @default(cuid())
  nodeId             String
  diskName           String
  temperatureC       Int
  reallocatedSectors Int
  pendingSectors     Int
  powerOnHours       Int
  overall            DiskHealth @default(unknown)
  collectedAt        DateTime   @default(now())
  node               Node       @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@index([nodeId, collectedAt])
  @@index([nodeId, diskName, collectedAt])
}

model Pool {
  id          String       @id @default(cuid())
  workspaceId String
  workspace   Workspace    @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String       @unique
  strategy    String
  status      PoolStatus   @default(pending)
  createdAt   DateTime     @default(now())
  updatedAt   DateTime     @updatedAt
  members     PoolMember[]

  @@index([workspaceId])
}

model PoolMember {
  id        String           @id @default(cuid())
  poolId    String
  nodeId    String
  role      PoolMemberRole   @default(replica)
  status    PoolMemberStatus @default(pending)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  pool      Pool             @relation(fields: [poolId], references: [id], onDelete: Cascade)
  node      Node             @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([poolId, nodeId])
  @@index([nodeId])
  @@index([status])
}

// A DNS server group is a fleet of nodes running PowerDNS for one or more
// zones, with one `primary` (master) and one or more `secondary` (slave)
// members - real AXFR/IXFR zone transfer between them, not a Tarmac-managed
// config push, so a secondary keeps answering correctly even if the control
// plane or the primary node is down. Structurally mirrors Pool/PoolMember.
model DnsServerGroup {
  id            String                 @id @default(cuid())
  workspaceId   String
  workspace     Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name          String
  status        DnsServerGroupStatus   @default(pending)
  // Shared secret for AXFR/IXFR zone transfer between this group's members,
  // generated by whichever node is `primary` and relayed to `secondary`
  // members via the reconciliation loop. Plaintext at rest like the rest of
  // this app's operational config (Postgres access is already the trust
  // boundary here) - unlike Node.agentTokenHash, this can't be a one-way
  // hash since secondaries need the literal value to configure PowerDNS.
  tsigKeySecret String?
  createdAt     DateTime               @default(now())
  updatedAt     DateTime               @updatedAt
  members       DnsServerGroupMember[]
  zones         DnsZone[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
}

model DnsServerGroupMember {
  id             String                     @id @default(cuid())
  groupId        String
  nodeId         String
  role           DnsServerGroupMemberRole   @default(secondary)
  status         DnsServerGroupMemberStatus @default(pending)
  // Set by the agent when it can't bind port 53 while applying this member's
  // PowerDNS install ({ port, protocol, pid, processName }). Cleared as soon
  // as a subsequent apply/resolve succeeds. Surfaced in the DNS UI so the
  // user can choose to kill the conflicting process or pick another node.
  conflictDetail Json?
  createdAt      DateTime                   @default(now())
  updatedAt      DateTime                   @updatedAt
  group          DnsServerGroup             @relation(fields: [groupId], references: [id], onDelete: Cascade)
  node           Node                       @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([groupId, nodeId])
  @@index([nodeId])
  @@index([status])
}

model DnsZone {
  id            String         @id @default(cuid())
  workspaceId   String
  workspace     Workspace      @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  groupId       String
  group         DnsServerGroup @relation(fields: [groupId], references: [id], onDelete: Restrict)
  // FQDN without a trailing dot; the PowerDNS-style trailing-dot convention
  // is applied only at the service/agent boundary, not stored here.
  name          String
  dnssecEnabled Boolean        @default(true)
  status        DnsZoneStatus  @default(pending)
  // Real-world delegation verification (see DnsDelegationCheckService) -
  // distinct from `status` above, which only reflects local PowerDNS-apply
  // success and says nothing about whether the registrar/parent zone
  // actually points at us yet on the public internet.
  delegationVerified  Boolean   @default(false)
  delegationCheckedAt DateTime?
  // Per-nameserver breakdown: [{ host, expectedIp, nsVisible, resolvedIp, matches, ok }]
  delegationDetail    Json?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt
  records       DnsRecord[]

  @@unique([workspaceId, name])
  @@index([workspaceId])
  @@index([groupId])
  @@index([status, delegationVerified])
}

// One row = one RRset (all values for a given name+type answered together).
model DnsRecord {
  id        String           @id @default(cuid())
  zoneId    String
  zone      DnsZone          @relation(fields: [zoneId], references: [id], onDelete: Cascade)
  // Relative label ("www", "@" for the zone apex).
  name      String
  type      DnsRecordType
  ttl       Int              @default(3600)
  // false: plain multi-value RRset (round-robin). true: rendered as a
  // PowerDNS Lua record (pickclosest(...)) over `values` for GeoDNS.
  isGeo     Boolean          @default(false)
  status    DnsRecordStatus  @default(pending)
  createdAt DateTime         @default(now())
  updatedAt DateTime         @updatedAt
  values    DnsRecordValue[]

  @@unique([zoneId, name, type])
  @@index([zoneId])
  @@index([status])
}

model DnsRecordValue {
  id        String    @id @default(cuid())
  recordId  String
  record    DnsRecord @relation(fields: [recordId], references: [id], onDelete: Cascade)
  // IP for A/AAAA, hostname for CNAME/MX/NS, free text for TXT/CAA.
  content   String
  // Set when this value targets one of the workspace's own fleet nodes -
  // drives the "which records point here" reverse lookup from a node.
  nodeId    String?
  node      Node?     @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  // MX/SRV only.
  priority  Int?
  createdAt DateTime  @default(now())

  @@index([recordId])
  @@index([nodeId])
}

model NotificationChannel {
  id          String                  @id @default(cuid())
  workspaceId String
  workspace   Workspace               @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name        String
  type        NotificationChannelType
  target      String
  enabled     Boolean                 @default(true)
  createdAt   DateTime                @default(now())
  updatedAt   DateTime                @updatedAt
  rules       AlertRule[]

  @@index([workspaceId])
}

model AlertRule {
  id                    String               @id @default(cuid())
  workspaceId           String
  workspace             Workspace            @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name                  String
  metric                String
  comparator            Comparator           @default(gte)
  threshold             Float
  severity              AlertSeverity        @default(medium)
  enabled               Boolean              @default(true)
  nodeId                String?
  notificationChannelId String?
  createdAt             DateTime             @default(now())
  updatedAt             DateTime             @updatedAt
  node                  Node?                @relation("NodeAlertRules", fields: [nodeId], references: [id])
  notificationChannel   NotificationChannel? @relation(fields: [notificationChannelId], references: [id])
  alerts                Alert[]

  @@index([enabled])
  @@index([workspaceId])
}

model Alert {
  id             String        @id @default(cuid())
  workspaceId    String
  workspace      Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  ruleId         String?
  nodeId         String?
  message        String
  severity       AlertSeverity @default(medium)
  status         AlertStatus   @default(open)
  triggeredAt    DateTime      @default(now())
  acknowledgedAt DateTime?
  resolvedAt     DateTime?
  createdAt      DateTime      @default(now())
  updatedAt      DateTime      @updatedAt
  rule           AlertRule?    @relation(fields: [ruleId], references: [id], onDelete: SetNull)
  node           Node?         @relation("NodeAlerts", fields: [nodeId], references: [id], onDelete: SetNull)

  @@index([triggeredAt])
  @@index([status])
  @@index([nodeId])
  @@index([workspaceId])
}

model SyncJob {
  id                    String        @id @default(cuid())
  workspaceId           String
  workspace             Workspace     @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name                  String
  sourcePath            String
  targetPath            String
  schedule              String
  status                SyncJobStatus @default(pending)
  nodeId                String?
  // Optional remote SSH source (e.g. an external seedbox outside the Tarmac
  // node fleet). When set, the agent pulls sourcePath from this host instead
  // of treating it as a local path. Auth is by SSH key only - the agent's own
  // key (public key surfaced via Node.overlaySshPublicKey) must be added to
  // the remote host's authorized_keys. No password is ever stored at rest.
  sourceHost            String?
  sourceUser            String?
  sourceSshPort         Int?          @default(22)
  // Hash of the per-job secret used by POST /sync-jobs/:id/trigger to start a
  // run without an interactive JWT session (e.g. from a qBittorrent
  // "run on completion" script). Same sha256-at-rest pattern as
  // Node.agentTokenHash - the plaintext is only ever returned once, at
  // creation or rotation time.
  triggerTokenHash      String?
  triggerTokenRotatedAt DateTime?
  lastRunAt             DateTime?
  createdAt             DateTime      @default(now())
  updatedAt             DateTime      @updatedAt
  node                  Node?         @relation(fields: [nodeId], references: [id], onDelete: SetNull)
  runs                  SyncJobRun[]

  @@index([workspaceId])
}

model SyncJobRun {
  id               String        @id @default(cuid())
  syncJobId        String
  status           SyncJobStatus @default(running)
  trigger          String        @default("manual")
  bytesTransferred Int           @default(0)
  log              String?
  startedAt        DateTime      @default(now())
  finishedAt       DateTime?
  createdAt        DateTime      @default(now())
  updatedAt        DateTime      @updatedAt
  syncJob          SyncJob       @relation(fields: [syncJobId], references: [id], onDelete: Cascade)

  @@index([syncJobId, startedAt])
}

model MigrationTask {
  id           String          @id @default(cuid())
  workspaceId  String
  workspace    Workspace       @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name         String
  shareId      String?
  sourceNodeId String?
  targetNodeId String?
  status       MigrationStatus @default(pending)
  progress     Int             @default(0)
  notes        String?
  startedAt    DateTime?
  completedAt  DateTime?
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  sourceNode   Node?           @relation("MigrationSourceNode", fields: [sourceNodeId], references: [id], onDelete: SetNull)
  targetNode   Node?           @relation("MigrationTargetNode", fields: [targetNodeId], references: [id], onDelete: SetNull)

  @@index([sourceNodeId, status])
  @@index([workspaceId])
}

// resourceType/resourceId stay generic (no FK) since AuditLog spans every
// resource kind. workspaceId is nullable because some rows predate
// workspaces or record platform-level (cross-workspace) actions.
model AuditLog {
  id           String     @id @default(cuid())
  workspaceId  String?
  workspace    Workspace? @relation(fields: [workspaceId], references: [id], onDelete: SetNull)
  actorUserId  String?
  action       String
  resourceType String
  resourceId   String?
  details      Json?
  createdAt    DateTime   @default(now())

  @@index([createdAt])
  @@index([actorUserId])
  @@index([action])
  @@index([resourceType])
  @@index([workspaceId])
}

model AgentLog {
  id        String   @id @default(cuid())
  nodeId    String
  level     String
  message   String
  createdAt DateTime @default(now())

  @@index([nodeId, createdAt])
  @@index([createdAt])
}

model Vlan {
  id                String                 @id @default(cuid())
  // One workspace has exactly one Vlan (its private mesh) - see
  // vlan.service.ts getOrCreateVlan. Kept as a plain FK rather than 1:1
  // unique-constrained for now to avoid over-constraining before Phase 2
  // actually enforces the invariant in code.
  workspaceId       String
  workspace         Workspace              @relation(fields: [workspaceId], references: [id], onDelete: Restrict)
  name              String                 @unique
  subnetCidr        String
  description       String?
  status            String                 @default("active")
  createdAt         DateTime               @default(now())
  updatedAt         DateTime               @updatedAt
  members           VlanMember[]
  connections       VlanConnection[]
  connectionTests   VlanConnectionTest[]
  connectionSamples VlanConnectionSample[]

  @@index([workspaceId])
}

model VlanMember {
  id            String   @id @default(cuid())
  vlanId        String
  nodeId        String
  vlanIp        String
  vlanMac       String
  joinedAt      DateTime @default(now())
  lastHeartbeat DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
  vlan          Vlan     @relation(fields: [vlanId], references: [id], onDelete: Cascade)
  node          Node     @relation(fields: [nodeId], references: [id], onDelete: Cascade)

  @@unique([vlanId, nodeId])
  @@unique([vlanId, vlanIp])
  @@unique([vlanId, vlanMac])
  @@index([vlanId])
  @@index([nodeId])
}

model VlanConnection {
  id            String               @id @default(cuid())
  vlanId        String
  sourceNodeId  String
  targetNodeId  String
  status        VlanConnectionStatus @default(unknown)
  latencyMs     Float?
  packetLoss    Float?
  bandwidth     Float?
  lastCheckedAt DateTime?
  createdAt     DateTime             @default(now())
  updatedAt     DateTime             @updatedAt
  vlan          Vlan                 @relation(fields: [vlanId], references: [id], onDelete: Cascade)
  sourceNode    Node                 @relation("SourceNode", fields: [sourceNodeId], references: [id], onDelete: Cascade)
  targetNode    Node                 @relation("TargetNode", fields: [targetNodeId], references: [id], onDelete: Cascade)

  @@unique([vlanId, sourceNodeId, targetNodeId])
  @@index([vlanId])
  @@index([sourceNodeId])
  @@index([targetNodeId])
}

model VlanConnectionTest {
  id              String       @id @default(cuid())
  vlanId          String
  initiatorNodeId String
  targetNodeId    String
  testType        VlanTestType @default(ping)
  status          String       @default("pending")
  resultCode      Int?
  resultMessage   String?
  latencyMs       Float?
  packetLoss      Float?
  hops            Json?
  startedAt       DateTime     @default(now())
  completedAt     DateTime?
  createdAt       DateTime     @default(now())
  vlan            Vlan         @relation(fields: [vlanId], references: [id], onDelete: Cascade)
  initiatorNode   Node         @relation("InitiatorNode", fields: [initiatorNodeId], references: [id], onDelete: Cascade)

  @@index([vlanId])
  @@index([initiatorNodeId])
  @@index([startedAt])
}

model VlanConnectionSample {
  id           String               @id @default(cuid())
  vlanId       String
  sourceNodeId String
  targetNodeId String
  status       VlanConnectionStatus
  latencyMs    Float?
  packetLoss   Float?
  bandwidth    Float?
  createdAt    DateTime             @default(now())
  vlan         Vlan                 @relation(fields: [vlanId], references: [id], onDelete: Cascade)

  @@index([vlanId, sourceNodeId, targetNodeId, createdAt])
  @@index([createdAt])
}
